[Unit]
Description=Fitness Coach API
After=network.target postgresql.service docker.service

[Service]
Type=simple
User=a503357
WorkingDirectory=/home/a503357/fitness-app/api
ExecStart=/usr/bin/node server.js
EnvironmentFile=/home/a503357/fitness-app/api/.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
